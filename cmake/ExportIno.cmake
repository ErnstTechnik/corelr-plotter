# ExportIno.cmake -- run with  cmake -DROOT=<repo> -DOUT=<dir> -DVARIANT=serial|sd -P ExportIno.cmake
# Writes <OUT>/grbl_corelr/ : the firmware as the flat Arduino sketch the IDE expects (the .ino and the modules of the image in one folder, vendored sdfat under src/ for sd),
# plus the platform.local.txt that gives the IDE the flags it cannot be told otherwise. GENERATED: lives under build/, never committed (REQ-CoreLR-D-Build-0010).
foreach(v ROOT OUT VARIANT)
    if(NOT DEFINED ${v})
        message(FATAL_ERROR "ExportIno.cmake: ${v} is not set")
    endif()
endforeach()
include("${ROOT}/cmake/VariantModules.cmake")
set(S "${OUT}/grbl_corelr")
file(REMOVE_RECURSE "${OUT}")
file(MAKE_DIRECTORY "${S}/src")
file(GLOB app    "${ROOT}/firmware/app/*")
file(GLOB src    "${ROOT}/firmware/src/*")
file(GLOB config "${ROOT}/firmware/config/*")
# What belongs to the other image is not copied (cmake/variant_modules.txt, REQ-CoreLR-D-Build-0014): the IDE compiles every file it finds in the sketch folder.
corelr_variant_exclusions("${ROOT}" "${VARIANT}" other_image)
corelr_variant_filter(app "${other_image}")
corelr_variant_filter(src "${other_image}")
corelr_variant_filter(config "${other_image}")
file(COPY ${app} ${src} ${config} DESTINATION "${S}")
list(FIND other_image "${ROOT}/third_party/sdfat" sdfat_of_other_image)
if(sdfat_of_other_image EQUAL -1)
    file(COPY "${ROOT}/third_party/sdfat" DESTINATION "${S}/src")
endif()

# The IDE compiles the sketch folder and src/ (recursively) but gives no -I: the module that includes "sdfat/SdFat.h" must say where it is.
if(EXISTS "${S}/SDReader.cpp")
    file(READ "${S}/SDReader.cpp" t)
    string(REPLACE "#include \"sdfat/SdFat.h\"" "#include \"src/sdfat/SdFat.h\"" t "${t}")
    file(WRITE "${S}/SDReader.cpp" "${t}")
endif()

# The IDE has no way to pass -D: the variant is the default in SwConfig.h.
if(VARIANT STREQUAL "sd")
    file(READ "${S}/SwConfig.h" t)
    string(REPLACE "#define CORELR_JOB_SOURCE CORELR_JOB_SOURCE_SERIAL" "#define CORELR_JOB_SOURCE CORELR_JOB_SOURCE_SD" t2 "${t}")
    if(t2 STREQUAL t)
        message(FATAL_ERROR "ExportIno.cmake: the default job source line of SwConfig.h was not found")
    endif()
    file(WRITE "${S}/SwConfig.h" "${t2}")
endif()

# The size flags, from the one list the build reads too (cmake/size_flags.txt): the lines marked `on`, and the ones marked with this variant's name (`sd` / `serial`).
set(cflags "-mcall-prologues -DCORELR_CALL_PROLOGUES=1")
set(lflags "")
file(STRINGS "${ROOT}/cmake/size_flags.txt" size_lines REGEX "^[^#].*\\|")
foreach(l IN LISTS size_lines)
    # four fields, the third one (the linker flag) often empty: a regular expression keeps the empty field under every CMake policy (list(GET) on "a;b;;sd" counts
    # three elements when CMP0007 is not set, as in a script run by `cmake -P` on CMake 3.x: the first release workflow run failed there)
    if(NOT l MATCHES "^([^|]*)\\|([^|]*)\\|([^|]*)\\|([^|]*)")
        message(FATAL_ERROR "ExportIno.cmake: a line of size_flags.txt does not have four fields: ${l}")
    endif()
    set(c "${CMAKE_MATCH_2}")
    set(lk "${CMAKE_MATCH_3}")
    set(status "${CMAKE_MATCH_4}")
    if(status STREQUAL "on" OR status STREQUAL VARIANT)
        string(APPEND cflags " ${c}")
        if(NOT lk STREQUAL "")
            string(APPEND lflags " ${lk}")
        endif()
    endif()
endforeach()
string(STRIP "${lflags}" lflags)
file(WRITE "${OUT}/platform.local.txt"
"# CoreLR -- build settings the Arduino IDE does not offer. GENERATED by `cmake --build <dir> --target export_ino`.
# Copy this file next to platform.txt of the AVR core, then restart the IDE:
#   ~/.arduino15/packages/arduino/hardware/avr/<version>/            (snap: ~/snap/arduino/current/.arduino15/packages/arduino/hardware/avr/<version>/)
# -mcall-prologues: -1396 bytes of flash; the SD variant does not fit the Nano without it. CORELR_CALL_PROLOGUES=1 tells the sketch it was asked for.
# The other flags are the size flags of the project (cmake/size_flags.txt, REQ-CoreLR-D-Build-0012): -1236 bytes more on the SD variant. -mrelax also has to reach the LINK
# (compiler.c.elf.extra_flags).
# NOTE: it applies to EVERY sketch you compile afterwards, until you remove the file.
compiler.c.extra_flags=${cflags}
compiler.cpp.extra_flags=${cflags}
compiler.c.elf.extra_flags=${lflags}
")
file(WRITE "${OUT}/README.txt"
"CoreLR firmware exported for the Arduino IDE (variant: ${VARIANT}). GENERATED -- do not edit, do not commit: change firmware/ and export again.

1. Copy platform.local.txt next to the AVR core's platform.txt (see its header), restart the IDE.
2. Open grbl_corelr/grbl_corelr.ino. Board: Arduino Nano, Processor: ATmega328P (the NEW bootloader: 115200 baud; 'Old Bootloader' is 57600).
3. The variant is the default of CORELR_JOB_SOURCE in SwConfig.h (here: ${VARIANT}); edit it to switch.
Without step 1 the SD variant stops at an #error that says so; the serial variant builds but is 1202 bytes bigger.
The official build is CMake (README.md of the repository): this export is a convenience, and the IDE is not the reference.
")
message(STATUS "exported the ${VARIANT} sketch to ${S}")
